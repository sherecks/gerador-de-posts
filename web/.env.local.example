# Copie este arquivo para .env.local e preencha a chave.
# .env.local nunca é commitado (veja .gitignore) e nunca chega ao client:
# só a rota src/app/api/gerar/route.ts lê OPENAI_API_KEY, no servidor.

OPENAI_API_KEY=

# Opcional: nome do modelo de texto. Confirme o modelo/preço vigente na sua
# conta OpenAI antes de trocar — o padrão abaixo é só um ponto de partida.
# OPENAI_TEXT_MODEL=gpt-4o

# Opcional: pasta de dados alternativa (por padrão é ../data/carousels).
# KARAGUA_DATA_DIR=
